name "steamworks-smoke"
description "Runs the bindings against the real libsteam_api without needing Steam"
license "BSL-1.0"
targetType "executable"
targetPath "bin"
dependency "steamworks" path="../.."

// The SDK's redistributable library is copied next to the executable, where
// both its install name (@loader_path on macOS) and loadSteamworks() find it.
copyFiles "../../sdk/redistributable_bin/osx/libsteam_api.dylib" platform="osx"
copyFiles "../../sdk/redistributable_bin/linux64/libsteam_api.so" platform="linux-x86_64"
copyFiles "../../sdk/redistributable_bin/linuxarm64/libsteam_api.so" platform="linux-aarch64"
copyFiles "../../sdk/redistributable_bin/linux32/libsteam_api.so" platform="linux-x86"
copyFiles "../../sdk/redistributable_bin/win64/steam_api64.dll" platform="windows-x86_64"
copyFiles "../../sdk/redistributable_bin/steam_api.dll" platform="windows-x86"

configuration "linked" {
	targetName "smoke-linked"
	subConfiguration "steamworks" "linked"
	lflags "-L$PACKAGE_DIR/../../sdk/redistributable_bin/osx" platform="osx"
	lflags "-L$PACKAGE_DIR/../../sdk/redistributable_bin/linux64" "-rpath=$$ORIGIN" platform="linux-x86_64"
	lflags "-L$PACKAGE_DIR/../../sdk/redistributable_bin/linuxarm64" "-rpath=$$ORIGIN" platform="linux-aarch64"
	lflags "-L$PACKAGE_DIR/../../sdk/redistributable_bin/linux32" "-rpath=$$ORIGIN" platform="linux-x86"
	lflags "/LIBPATH:$PACKAGE_DIR/../../sdk/redistributable_bin/win64" platform="windows-x86_64"
	lflags "/LIBPATH:$PACKAGE_DIR/../../sdk/redistributable_bin" platform="windows-x86"
}

configuration "dynamic" {
	targetName "smoke-dynamic"
	subConfiguration "steamworks" "dynamic"
}
