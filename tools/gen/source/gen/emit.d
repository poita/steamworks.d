/// Emits the D modules of `steamworks.raw` from the model.
module gen.emit;

import std.algorithm : among, canFind, endsWith, map, sort, startsWith;
import std.array : array, join, replace;
import std.conv : to;
import std.exception : enforce;
import std.format : format;
import std.path : stripExtension;
import std.regex : ctRegex, regex, replaceAll, matchFirst;
import std.string : strip, toLower;

import gen.ctype;
import gen.headers;
import gen.model;

/// Generated source files: path relative to the repository root, and text.
alias Output = string[string];

/// Words D reserves that may appear as C identifiers.
private immutable string[] dKeywords = [
    "abstract", "alias", "align", "asm", "assert", "auto", "body", "bool", "break", "byte", "case",
    "cast", "catch", "cdouble", "cent", "cfloat", "char", "class", "const", "continue", "creal",
    "dchar", "debug", "default", "delegate", "delete", "deprecated", "do", "double", "else",
    "enum", "export", "extern", "false", "final", "finally", "float", "for", "foreach",
    "foreach_reverse", "function", "goto", "idouble", "if", "ifloat", "immutable", "import",
    "in", "inout", "int", "interface", "invariant", "ireal", "is", "lazy", "long", "macro",
    "mixin", "module", "new", "nothrow", "null", "out", "override", "package", "pragma", "private",
    "protected", "public", "pure", "real", "ref", "return", "scope", "shared", "short", "static",
    "struct", "super", "switch", "synchronized", "template", "this", "throw", "true", "try",
    "typeid", "typeof", "ubyte", "ucent", "uint", "ulong", "union", "unittest", "ushort",
    "version", "void", "wchar", "while", "with"
];

/// Escapes a C identifier that is a D keyword by appending `_`.
string dIdent(string name) @safe pure
{
    return dKeywords.canFind(name) ? name ~ "_" : name;
}

/// Small indentation-aware line buffer.
struct Code
{
    string text;
    int depth;

    void line(string s = null) @safe pure
    {
        if (s.length)
        {
            foreach (_; 0 .. depth)
                text ~= "    ";
            text ~= s;
        }
        text ~= "\n";
    }

    void open() @safe pure
    {
        line("{");
        ++depth;
    }

    void close(string suffix = null) @safe pure
    {
        --depth;
        line("}" ~ suffix);
    }

    void doc(string s) @safe pure
    {
        foreach (l; s.splitLinesKeep)
            line(l.length ? "/// " ~ l : "///");
    }
}

private string[] splitLinesKeep(string s) @safe pure
{
    import std.string : lineSplitter;

    return s.lineSplitter.array;
}

/// The banner every generated module starts with.
string banner(string sdkVersion) @safe pure
{
    return "// Generated by tools/gen from the Steamworks SDK " ~ sdkVersion ~ " (steam_api.json,\n"
        ~ "// tools/gen/overrides.json and the SDK headers). Do not edit; regenerate instead.\n";
}

/// Imports shared by the generated modules.
private immutable string[] typeModules = [
    "steamworks.raw.callbacks", "steamworks.raw.consts", "steamworks.raw.enums",
    "steamworks.raw.interfaces", "steamworks.raw.manual", "steamworks.raw.platform",
    "steamworks.raw.steamid", "steamworks.raw.structs", "steamworks.raw.types",
];

private void imports(ref Code c, string self, string[] extra = null)
{
    string[] mods = typeModules.dup ~ extra;
    mods.sort();
    foreach (m; mods)
        if (m != self)
            c.line("import " ~ m ~ ";");
}

/// Partner documentation page for a header, or null.
string docPage(string header) @safe pure
{
    static immutable string[string] pages = [
        "isteamapps.h": "ISteamApps", "isteamclient.h": "ISteamClient",
        "isteamcontroller.h": "ISteamController", "isteamfriends.h": "ISteamFriends",
        "isteamgameserver.h": "ISteamGameServer", "isteamgameserverstats.h": "ISteamGameServerStats",
        "isteamhtmlsurface.h": "ISteamHTMLSurface", "isteamhttp.h": "ISteamHTTP",
        "isteaminput.h": "ISteamInput", "isteaminventory.h": "ISteamInventory",
        "isteammatchmaking.h": "ISteamMatchmaking", "isteammusic.h": "ISteamMusic",
        "isteamnetworking.h": "ISteamNetworking",
        "isteamnetworkingmessages.h": "ISteamNetworkingMessages",
        "isteamnetworkingsockets.h": "ISteamNetworkingSockets",
        "isteamnetworkingutils.h": "ISteamNetworkingUtils",
        "isteamparentalsettings.h": "ISteamParentalSettings",
        "isteamremoteplay.h": "ISteamRemotePlay", "isteamremotestorage.h": "ISteamRemoteStorage",
        "isteamscreenshots.h": "ISteamScreenshots", "isteamtimeline.h": "ISteamTimeline",
        "isteamugc.h": "ISteamUGC", "isteamuser.h": "ISteamUser",
        "isteamuserstats.h": "ISteamUserStats", "isteamutils.h": "ISteamUtils",
        "isteamvideo.h": "ISteamVideo", "steam_api.h": "steam_api",
        "steam_gameserver.h": "steam_gameserver",
        "steamnetworkingtypes.h": "steamnetworkingtypes", "steamclientpublic.h": "steam_api",
    ];
    if (auto p = header in pages)
        return "https://partner.steamgames.com/doc/api/" ~ *p;
    return null;
}

/// Context for rendering types.
struct Ctx
{
    const(Model)* m;
    bool[string] classTypes;
    bool[string] enumNames;
    long[string] enumFirstValue;

    this(const ref Model model)
    {
        m = &model;
        foreach (ref i; model.interfaces)
            if (i.cppCallback)
                classTypes[i.name] = true;
        foreach (n; model.manualClasses)
            classTypes[n] = true;
        foreach (ref e; model.enums)
        {
            enumNames[e.name] = true;
            enumFirstValue[e.name] = e.values.length ? e.values[0].value : 0;
        }
    }

    string d(const CType t, Use use = Use.value) const
    {
        return toD(t, m.typeMap, use, classTypes);
    }
}

// ---------------------------------------------------------------------------
// types.d

string emitTypes(const ref Model m, string sdk)
{
    auto ctx = Ctx(m);
    Code c;
    c.text = banner(sdk);
    c.line();
    c.line("/// Typedefs from the Steamworks headers.");
    c.line("module steamworks.raw.types;");
    c.line();
    c.line("import core.stdc.config : c_long, c_ulong;");
    imports(c, "steamworks.raw.types");
    c.line();
    c.line("// Fixed-size buffers are passed by pointer to a static array, as in C.");
    c.line();
    foreach (ref t; m.typedefs)
    {
        if (t.dCode.length)
        {
            c.doc(t.name ~ ". " ~ t.doc);
            c.line(t.dCode);
        }
        else
        {
            if (t.doc.length)
                c.doc(t.doc ~ (t.header.length ? " (" ~ t.header ~ ")" : ""));
            else
                c.doc(t.name ~ ".");
            c.line(format!"alias %s = %s;"(t.name, ctx.d(t.type)));
        }
    }
    return c.text;
}

// ---------------------------------------------------------------------------
// consts.d

/// Translates a C constant expression into D.
string cExprToD(string expr, const string[] typeNames) @safe
{
    string s = expr.strip;
    // Integer suffixes: D has no lowercase `l` and spells `ull` as `UL`.
    s = s.replaceAll(regex(`\b(0[xX][0-9a-fA-F]+|\d+)(?:[uU][lL][lL]|[lL][lL][uU])\b`), "$1UL");
    s = s.replaceAll(regex(`\b(0[xX][0-9a-fA-F]+|\d+)[lL][lL]\b`), "$1L");
    // `600.f` is not a D float literal.
    s = s.replaceAll(regex(`\b(\d+)\.f\b`), "$1.0f");
    // C casts of known types: `( uint32 ) x` becomes `cast(uint32) x`.
    foreach (t; typeNames)
        s = s.replaceAll(regex(`\(\s*` ~ t ~ `\s*\)\s*`), "cast(" ~ t ~ ") ");
    return s;
}

private bool isSignedIntD(string d) @safe pure
{
    return d.among("byte", "short", "int", "long") != 0;
}

private string constDecl(const ref Const k, const ref Ctx ctx)
{
    import std.conv : parse;

    static immutable castTypes = [
        "uint32", "uint64", "int32", "int64", "uint16", "uint8", "SteamItemInstanceID_t"
    ];
    string dtype = ctx.d(k.type);
    string val = cExprToD(k.cvalue, castTypes);
    // A hex literal above the signed range needs an explicit wrap-around cast.
    if (auto mm = val.matchFirst(ctRegex!(`^0[xX]([0-9a-fA-F]+)$`)))
    {
        string digits = mm[1];
        const v = parse!ulong(digits, 16);
        const resolved = resolveAlias(dtype, *ctx.m);
        if (isSignedIntD(resolved) && v > signedMax(resolved))
            val = "cast(" ~ dtype ~ ") " ~ val;
    }
    return format!"enum %s %s = %s;"(dtype, k.name, val);
}

private ulong signedMax(string d) @safe pure
{
    switch (d)
    {
    case "byte":
        return byte.max;
    case "short":
        return short.max;
    case "int":
        return int.max;
    default:
        return long.max;
    }
}

/// Follows typedef aliases down to a D builtin name.
string resolveAlias(string dtype, const ref Model m)
{
    foreach (_; 0 .. 8)
    {
        bool found;
        foreach (ref t; m.typedefs)
            if (t.name == dtype && !t.dCode.length && !t.type.isFunctionPointer
                    && t.type.ptrs.length == 0 && t.type.dims.length == 0)
            {
                dtype = dBase(t.type.base, m.typeMap);
                found = true;
                break;
            }
        if (!found)
            break;
    }
    return dtype;
}

string emitConsts(const ref Model m, string sdk)
{
    auto ctx = Ctx(m);
    Code c;
    c.text = banner(sdk);
    c.line();
    c.line("/// Constants from the Steamworks headers.");
    c.line("module steamworks.raw.consts;");
    c.line();
    imports(c, "steamworks.raw.consts");
    c.line();
    foreach (ref k; m.consts)
    {
        c.doc(k.name ~ (k.header.length ? " (" ~ k.header ~ ")." : "."));
        c.line(constDecl(k, ctx));
    }
    return c.text;
}

// ---------------------------------------------------------------------------
// enums.d

private void emitEnum(ref Code c, const ref Enum e, string docText)
{
    c.doc(docText);
    c.line(format!"enum %s : %s"(e.name, e.baseType));
    c.open();
    foreach (ref v; e.values)
        c.line(format!"%s = %s,"(v.name, v.value));
    c.close();
}

string emitEnums(const ref Model m, string sdk)
{
    Code c;
    c.text = banner(sdk);
    c.line();
    c.line("/// Enums from the Steamworks headers.");
    c.line("///");
    c.line("/// Each enumerator is also available unqualified (`k_EResultOK`), as in C++.");
    c.line("module steamworks.raw.enums;");
    c.line();
    foreach (ref e; m.enums)
    {
        string where = e.header.length ? " (" ~ e.header ~ ")" : "";
        const page = docPage(e.header);
        emitEnum(c, e, e.cname ~ where ~ "." ~ (page.length ? "\n\nSee_Also: " ~ page : ""));
        c.line();
        foreach (ref v; e.values)
            c.line(format!"enum %s = %s.%s; /// ditto"(v.name, e.name, v.name));
        c.line();
    }
    return c.text;
}

// ---------------------------------------------------------------------------
// structs.d and callbacks.d

private string alignTypeOf(const CType t, const ref Ctx ctx)
{
    if (t.isFunctionPointer || t.ptrs.length)
        return "void*";
    return ctx.d(t, Use.field);
}

private string fieldDecl(const ref Field f, const ref Struct s, const ref Ctx ctx)
{
    const ty = ctx.d(f.type, Use.field);
    string decl = ty ~ " " ~ dIdent(f.name);
    // Zero-initialise char and floating point fields so that `T.init` is all
    // zero bytes, as value-initialisation is in C++.
    if (!f.type.isFunctionPointer && f.type.ptrs.length == 0)
    {
        const b = dBase(f.type.base, ctx.m.typeMap);
        if (b.among("char", "float", "double"))
            decl ~= " = 0";
        else if (auto p = b in ctx.enumFirstValue)
            if (*p != 0)
                decl ~= f.type.dims.length ? " = cast(" ~ b ~ ") 0" : " = cast(" ~ b ~ ") 0";
    }
    if (s.pack.callback)
        decl = "align(callbackAlign!(" ~ alignTypeOf(f.type, ctx) ~ ")) " ~ decl;
    return decl ~ ";";
}

private void emitStruct(ref Code c, const ref Struct s, const ref Ctx ctx)
{
    string d = s.name ~ (s.header.length ? " (" ~ s.header ~ ")" : "") ~ ".";
    if (s.doc.length)
        d ~= " " ~ s.doc;
    if (s.callbackId >= 0)
        d ~= format!"\n\nCallback identifier %s."(s.callbackId);
    d ~= "\n\nLayout: " ~ (s.pack.callback
            ? "VALVE_CALLBACK_PACK (4 on Linux, macOS and FreeBSD; 8 elsewhere)" : s.pack.value
            ? format!"#pragma pack(%s)"(s.pack.value) : "natural alignment") ~ ".";
    if (s.jsonOnly)
        d ~= " Defined by steam_api.json only; the SDK headers just forward-declare it.";
    const page = docPage(s.header);
    if (page.length && s.callbackId >= 0)
        d ~= "\n\nSee_Also: " ~ page ~ "#" ~ s.name;
    c.doc(d);
    c.line("struct " ~ s.name);
    c.open();
    if (s.callbackId >= 0)
    {
        c.line("/// Callback identifier.");
        c.line(format!"enum int k_iCallback = %s;"(s.callbackId));
    }
    foreach (ref k; s.consts)
    {
        c.line("/// " ~ s.name ~ "::" ~ k.name ~ ".");
        c.line(constDecl(k, ctx));
    }
    foreach (ref e; s.enums)
    {
        emitEnum(c, e, s.name ~ "::" ~ e.name ~ ".");
        foreach (ref v; e.values)
            c.line(format!"enum %s = %s.%s; /// ditto"(v.name, e.name, v.name));
    }
    if (s.pack.value == 1)
        c.line("align(1):");
    else
        enforce(s.pack.value == 0, format!"unsupported pack %s for %s"(s.pack.value, s.name));
    foreach (ref f; s.fields)
    {
        c.line(fieldDecl(f, s, ctx));
    }
    c.close();
}

string emitStructs(const ref Model m, string sdk, bool callbacks)
{
    auto ctx = Ctx(m);
    const mod = callbacks ? "steamworks.raw.callbacks" : "steamworks.raw.structs";
    Code c;
    c.text = banner(sdk);
    c.line();
    if (callbacks)
    {
        c.line("/// Callback and call-result structs. Each has `enum int k_iCallback`.");
        c.line("///");
        c.line("/// Field alignment follows VALVE_CALLBACK_PACK through `callbackAlign`, so the");
        c.line("/// layout matches the platform's C++ compiler.");
    }
    else
        c.line("/// Plain data structs from the Steamworks headers.");
    c.line("module " ~ mod ~ ";");
    c.line();
    imports(c, mod);
    c.line();
    foreach (ref s; callbacks ? m.callbacks : m.structs)
    {
        emitStruct(c, s, ctx);
        c.line();
    }
    return c.text;
}

// ---------------------------------------------------------------------------
// interfaces.d

/// The interface version macro whose value is `ver`, if any.
string versionMacroFor(const ref Model m, string ver)
{
    foreach (k, v; m.headers.versionMacros)
        if (v == ver)
            return k;
    return null;
}

string emitInterfaces(const ref Model m, string sdk)
{
    auto ctx = Ctx(m);
    Code c;
    c.text = banner(sdk);
    c.line();
    c.line("/// Steam interface handles, interface version strings and the C++ callback");
    c.line("/// interfaces that applications implement.");
    c.line("module steamworks.raw.interfaces;");
    c.line();
    imports(c, "steamworks.raw.interfaces");
    c.line();
    auto macros = m.headers.versionMacros.keys;
    macros.sort();
    foreach (k; macros)
    {
        c.line(format!"/// SteamInterface version string (%s)."(k));
        c.line(format!"enum %s = \"%s\";"(k, m.headers.versionMacros[k]));
    }
    c.line();
    foreach (ref i; m.interfaces)
    {
        if (i.versionString.length)
            enforce(versionMacroFor(m, i.versionString).length, "no version macro for " ~ i.name ~ " " ~ i
                    .versionString);
        const page = docPage(i.header);
        if (i.cppCallback)
        {
            c.doc(format!("C++ callback interface %s (%s), implemented by the application.\n\n"
                    ~ "Derive an `extern (C++)` class from it and pass instances to ISteamMatchmakingServers. "
                    ~ "Steam keeps the pointer until the request completes or is cancelled, so the "
                    ~ "object must stay alive (and reachable by the GC) until then. Overrides must be "
                    ~ "`nothrow`: exceptions cannot cross the Steam client.")(i.name, i.header) ~ (page.length
                    ? "\n\nSee_Also: " ~ page ~ "#" ~ i.name : ""));
            c.line("extern (C++) abstract class " ~ i.name);
            c.open();
            foreach (ref f; i.methods)
            {
                // The virtual functions receive the object as `this`.
                string[] ps;
                foreach (ref p; f.params[1 .. $])
                    ps ~= ctx.d(virtualParamType(p.type), Use.param) ~ " " ~ dIdent(p.name);
                c.line("/// " ~ i.name ~ "::" ~ f.method ~ ".");
                c.line(format!"abstract %s %s(%s) nothrow;"(ctx.d(f.ret), f.method, ps.join(", ")));
            }
            c.close();
        }
        else
        {
            string d = format!"Opaque handle to the %s interface (%s)."(i.name, i.header);
            if (i.accessors.length)
                d ~= " Obtain it with " ~ i.accessors.map!(a => "`SteamAPI_" ~ a.name ~ "()`").join(" or ") ~ ".";
            if (i.versionString.length)
                d ~= format!"\n\nInterface version: `%s`."(i.versionString);
            if (page.length)
                d ~= "\n\nSee_Also: " ~ page;
            c.doc(d);
            c.line("struct " ~ i.name ~ ";");
        }
        c.line();
    }
    foreach (ref o; m.opaques)
    {
        c.doc(format!"Opaque type (%s). %s"(o.header, o.doc));
        c.line("struct " ~ o.name ~ ";");
        c.line();
    }
    return c.text;
}

// ---------------------------------------------------------------------------
// Function modules.

/// Module (header basename) a function is emitted into.
string moduleOf(const ref Function f)
{
    string h = f.header;
    if (h.among("steam_api_common.h", "steam_api_internal.h"))
        h = "steam_api.h";
    return h.stripExtension;
}

private string fnDoc(const ref Function f)
{
    string d;
    if (f.owner.length && f.method.length)
    {
        d = f.owner ~ "::" ~ f.method ~ " (" ~ f.header ~ ").";
        const page = docPage(f.header);
        if (f.callResult.length)
            d ~= "\n\nCompletes asynchronously with call result `" ~ f.callResult ~ "`.";
        if (f.callbacks.length)
            d ~= "\n\nMakes Steam post callback" ~ (f.callbacks.length > 1
                    ? "s " : " ") ~ f.callbacks.map!(c => "`" ~ c ~ "`").join(" and ") ~ ".";
        if (page.length && f.owner.startsWith("ISteam"))
            d ~= "\n\nSee_Also: " ~ page ~ "#" ~ f.method;
    }
    else
    {
        d = f.name ~ " (" ~ f.header ~ "). " ~ f.doc;
    }
    return d;
}

private string udas(const ref Function f)
{
    string u;
    if (f.callResult.length)
        u ~= "@SteamCallResult!(" ~ f.callResult ~ ")() ";
    if (f.callbacks.length)
        u ~= "@SteamCallback!(" ~ f.callbacks.join(", ") ~ ")() ";
    return u;
}

private string paramList(const ref Function f, const ref Ctx ctx)
{
    string[] ps;
    foreach (ref p; f.params)
        ps ~= ctx.d(p.type, Use.param) ~ " " ~ dIdent(p.name);
    return ps.join(", ");
}

/// Emits one function module.
string emitFunctionModule(const ref Model m, string sdk, string mod, const(Function)[] fns,
        const(SteamInterface)[] ifaces)
{
    auto ctx = Ctx(m);
    Code c;
    c.text = banner(sdk);
    c.line();
    c.line(format!"/// Flat API functions declared by %s.h."(mod));
    c.line("///");
    c.line("/// With the `SteamworksDynamic` version (dub configuration \"dynamic\") each function");
    c.line("/// is a pointer that `loadSteamworks` fills in; otherwise they are linked directly.");
    c.line("module steamworks.raw." ~ mod ~ ";");
    c.line();
    imports(c, "steamworks.raw." ~ mod, ["steamworks.raw.attributes"]);
    c.line();
    c.line("version (SteamworksDynamic)");
    c.open();
    c.line("private extern (C) nothrow @nogc");
    c.open();
    foreach (ref f; fns)
        c.line(format!"alias PFN_%s = %s function(%s);"(f.name, ctx.d(f.ret), paramList(f, ctx)));
    c.close();
    c.line();
    c.line("__gshared");
    c.open();
    foreach (i, ref f; fns)
    {
        if (i)
            c.line();
        c.doc(fnDoc(f));
        c.line(format!"%sPFN_%s %s;"(udas(f), f.name, f.name));
    }
    c.close();
    c.close();
    c.line("else");
    c.open();
    c.line("extern (C) nothrow @nogc");
    c.open();
    foreach (i, ref f; fns)
    {
        if (i)
            c.line();
        c.doc(fnDoc(f));
        c.line(format!"%s%s %s(%s);"(udas(f), ctx.d(f.ret), f.name, paramList(f, ctx)));
    }
    c.close();
    c.close();
    foreach (ref i; ifaces)
        foreach (ref a; i.accessors)
        {
            c.line();
            c.doc(format!("Returns the %s interface (%s accessor); `null` before initialization\n"
                    ~ "and, with the `SteamworksDynamic` version, when the library is not loaded or lacks it.\n\n"
                    ~ "Unversioned form of `%s`, matching the inline function in steam_api_flat.h.")(i.name,
                    a.kind, a.flatName));
            c.line(format!"%s* SteamAPI_%s() nothrow @nogc"(i.name, a.name));
            c.open();
            c.line("version (SteamworksDynamic)");
            c.line(format!"    if (%s is null)"(a.flatName));
            c.line("        return null;");
            c.line(format!"return %s();"(a.flatName));
            c.close();
        }
    return c.text;
}

/// Groups every function by module, keeping model order inside each module.
string[] functionModules(const ref Model m)
{
    bool[string] seen;
    string[] mods;
    foreach (ref f; m.allFunctions)
    {
        const mod = moduleOf(f);
        if (mod !in seen)
        {
            seen[mod] = true;
            mods ~= mod;
        }
    }
    mods.sort();
    return mods;
}

// ---------------------------------------------------------------------------
// symbols.d and package.d

string emitSymbols(const ref Model m, string sdk)
{
    Code c;
    c.text = banner(sdk);
    c.line();
    c.line("/// The complete list of C functions the bindings declare, and the hook the");
    c.line("/// dynamic loader uses to bind them.");
    c.line("module steamworks.raw.symbols;");
    c.line();
    foreach (mod; functionModules(m))
        c.line("import steamworks.raw." ~ mod ~ ";");
    c.line();
    const fns = m.allFunctions;
    c.line(format!"/// Number of C functions the bindings declare.");
    c.line(format!"enum size_t steamworksFunctionCount = %s;"(fns.length));
    c.line();
    // The tables below are one entry per line; dfmt would take minutes to
    // re-wrap them.
    c.line("// dfmt off");
    c.line("/// Names of every C function the bindings declare.");
    c.line("immutable string[steamworksFunctionCount] steamworksFunctionNames = [");
    ++c.depth;
    foreach (ref f; fns)
        c.line("\"" ~ f.name ~ "\",");
    --c.depth;
    c.line("];");
    c.line();
    c.line("/// Exports of libsteam_api that the SDK headers do not declare and the bindings");
    c.line("/// deliberately leave unbound (legacy or internal entry points).");
    c.line("immutable string[] steamworksUnboundExports = [");
    ++c.depth;
    foreach (n; m.unboundExports)
        c.line("\"" ~ n ~ "\",");
    --c.depth;
    c.line("];");
    c.line();
    c.line("/// Calls `dg` with the name and current address of every function, in");
    c.line("/// `steamworksFunctionNames` order. With the dynamic loader an address is `null`");
    c.line("/// until bound; when linked, referencing every function makes the linker check");
    c.line("/// that the library provides all of them.");
    c.line("void steamworksForEachFunction(scope void delegate(string name, void* address) nothrow @nogc dg)");
    c.line("    nothrow @nogc");
    c.open();
    c.line("version (SteamworksDynamic)");
    c.open();
    foreach (ref f; fns)
        c.line(format!"dg(\"%s\", cast(void*) %s);"(f.name, f.name));
    c.close();
    c.line("else");
    c.open();
    foreach (ref f; fns)
        c.line(format!"dg(\"%s\", cast(void*) &%s);"(f.name, f.name));
    c.close();
    c.close();
    c.line();
    c.line("version (SteamworksDynamic)");
    c.open();
    c.line("/// Resolves one symbol: stores its address in `*slot` (or null) and returns");
    c.line("/// whether it was found.");
    c.line("alias SteamworksSymbolResolver = bool delegate(void** slot, const(char)* name) nothrow @nogc;");
    c.line();
    c.line("/// Binds every function pointer through `resolve`; returns how many were missing.");
    c.line("size_t bindSteamworksSymbols(scope SteamworksSymbolResolver resolve) nothrow @nogc");
    c.open();
    c.line("size_t missing;");
    foreach (ref f; fns)
        c.line(format!"missing += !resolve(cast(void**) &%s, \"%s\");"(f.name, f.name));
    c.line("return missing;");
    c.close();
    c.close();
    c.line("// dfmt on");
    return c.text;
}

string emitPackage(const ref Model m, string sdk)
{
    Code c;
    c.text = banner(sdk);
    c.line();
    c.line("/// The complete raw Steamworks flat API: every type, constant, enum, struct,");
    c.line("/// callback, interface and exported function of the SDK, with the C names.");
    c.line("module steamworks.raw;");
    c.line();
    string[] mods = typeModules.dup ~ [
        "steamworks.raw.attributes", "steamworks.raw.helpers", "steamworks.raw.symbols"
    ];
    foreach (mod; functionModules(m))
        mods ~= "steamworks.raw." ~ mod;
    mods.sort();
    foreach (mod; mods)
        c.line("public import " ~ mod ~ ";");
    return c.text;
}

/// Generates every module.
Output generate(const ref Model m, string sdk)
{
    Output o;
    enum dir = "source/steamworks/raw/";
    o[dir ~ "types.d"] = emitTypes(m, sdk);
    o[dir ~ "consts.d"] = emitConsts(m, sdk);
    o[dir ~ "enums.d"] = emitEnums(m, sdk);
    o[dir ~ "structs.d"] = emitStructs(m, sdk, false);
    o[dir ~ "callbacks.d"] = emitStructs(m, sdk, true);
    o[dir ~ "interfaces.d"] = emitInterfaces(m, sdk);
    o[dir ~ "symbols.d"] = emitSymbols(m, sdk);
    o[dir ~ "package.d"] = emitPackage(m, sdk);
    foreach (mod; functionModules(m))
    {
        const(Function)[] fns;
        foreach (ref f; m.allFunctions)
            if (moduleOf(f) == mod)
                fns ~= f;
        const(SteamInterface)[] ifaces;
        foreach (ref i; m.interfaces)
            if (i.header.stripExtension == mod)
                ifaces ~= i;
        o[dir ~ mod ~ ".d"] = emitFunctionModule(m, sdk, mod, fns, ifaces);
    }
    return o;
}

/// The parameter type of a C++ callback interface's virtual function, given
/// its flat function's parameter type: the flat API passes `CSteamID` and
/// `CGameID` by value as `uint64_steamid` and `uint64_gameid`, the virtual
/// functions take the classes themselves.
const(CType) virtualParamType(const CType t) @safe pure nothrow
{
    if (t.ptrs.length || t.isRef || t.dims.length || t.isFunctionPointer)
        return t;
    CType r;
    r.baseConst = t.baseConst;
    if (t.base == "uint64_steamid")
        r.base = "CSteamID";
    else if (t.base == "uint64_gameid")
        r.base = "CGameID";
    else
        return t;
    return r;
}

